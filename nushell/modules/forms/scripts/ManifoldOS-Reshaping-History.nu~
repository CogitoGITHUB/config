# =============================================================================
# ManifoldOS — Reshaping History
#
# What is this file?
#
#   This is the git/jj layer of the ManifoldOS reshape loop. It owns everything
#   that happens to the repository after a successful reconfigure: safety
#   checks, committing, pushing, and rendering the post-push state.
#
#   jj is used for working copy management, commit description, and operation
#   log. git (via colocated mode) remains intact so Magit and other git tools
#   continue to work without modification.
#
#   On first run in a repo, jj is initialized automatically with --colocate
#   so the repo is never left in a broken state.
#
# Pipeline stages:
#
#   1. INIT    — Ensures jj is initialized in the repo (colocated). No-op if
#                already set up.
#
#   2. FETCH   — jj git fetch (reflected in git immediately). Guards against
#                dirty working copy before fetching.
#
#   3. CHECK   — Safety checks against upstream state using jj revsets.
#                Detects conflicts and aborts before commit.
#
#   4. COMMIT  — jj describe + jj new (no staging — jj tracks working copy)
#
#   5. PUSH    — Dry-run preview with confirmation, then jj git push.
#
# Public API:
#
#   ManifoldOS-Reshaping-History [msg]
#     Full pipeline. Called by ManifoldOS-Reshaping.nu after reconfigure,
#     or standalone via Ctrl+G. Snapshots op ID before running for safe undo.
#
#   print-git-sections [repo, changed, push_results, pre_op_id]
#     Read-only render of git/jj state. Called by ManifoldOS-Reshaping.nu.
#     Now includes op log and undo target after every push.
#
#   fetch-commits-from [repo, n]
#     Last N commits as structured table. Uses jj log (change IDs visible).
#     Falls back to git log if jj template fails.
#
#   fetch-status-from [repo]
#     Raw jj status lines for working copy.
#
#   fetch-repo-stats-from [repo, --json]
#     Single-glance repo metrics record. ahead/behind are tri-state:
#     int or null (renders as "?") — never silently wrong. Pass --json
#     to get machine-readable output for dashboards or status bars.
#
#   fetch-op-log-from [repo, n]
#     Last N jj operations. Wired into post-push render.
#
#   snapshot-op-id [repo]
#     Current op ID before pipeline runs — printed as restore target.
#
# Convenience commands:
#
#   jj-undo          — jj op undo (Ctrl+Z)
#   jj-restore-op    — jj op restore to a specific op ID
#   jj-split         — jj split (interactive)
#   jj-squash        — jj squash into parent
#   jj-evolog        — jj evolog for current change
#   jj-stats-json    — fetch-repo-stats-from --json
#
# Keybindings:
#
#   Ctrl+G runs the history pipeline standalone from any prompt.
#   Ctrl+Z runs jj-undo.
#
# =============================================================================


# =============================================================================
# CONFIGURATION
# =============================================================================

let config = {
    verbose_failures:  true
    commits_to_show:   10
    op_log_to_show:    5
}


# =============================================================================
# SECTION 0 — JJ INIT
# =============================================================================

def ensure-jj-initialized [repo: string] {
    let jj_dir = ($repo | path join ".jj")
    if not ($jj_dir | path exists) {
        print $"(ansi yellow)  jj not initialized — running jj git init --colocate(ansi reset)"
        let result = (do { cd $repo; jj git init --colocate } | complete)
        if $result.exit_code != 0 {
            print -e $"(ansi red_bold)  ✗ jj init failed:(ansi reset) ($result.stderr)"
            return false
        }
        print $"(ansi green)  ✓ jj initialized (colocated)(ansi reset)"
    }
    true
}


# =============================================================================
# SECTION 1 — FLOW ENGINE
# =============================================================================

def rh-flow [steps: list, current: string, timings: record] {
    print -n "\e[2J\e[H"
    print ""
    print $"(ansi red_bold)🌹 MANIFOLD // RESHAPING HISTORY 🌹(ansi reset)"
    print $"(ansi grey)  A staged collapse of repository time.(ansi reset)"
    print ""

    for step in $steps {
        let name      = $step.name
        let elapsed   = ($timings | get -i $name | default "")
        let is_done   = ($elapsed | is-not-empty)
        let is_active = ($name == $current)
        let symbol    = if $is_done and not $is_active { "🌹" } else if $is_active { "►" } else { "○" }
        let suffix    = if $is_active { "───► running" } else if $is_done { $"✓  ($elapsed)" } else { "" }
        print $"  ($symbol)  ($name)  ($suffix)"
    }
    print ""
}


# =============================================================================
# SECTION 2 — SAFETY CHECKS
# =============================================================================

# Returns true if working copy has uncommitted changes
def has-dirty-working-copy [repo: string] {
    try {
        (jj --repository $repo diff --stat | str trim | is-not-empty)
    } catch {
        false
    }
}

# Returns true if any commits in working copy are conflicted
def has-conflicts [repo: string] {
    try {
        (jj --repository $repo log --no-graph -r 'conflicts()' | str trim | is-not-empty)
    } catch {
        false
    }
}


# =============================================================================
# SECTION 3 — DATA COLLECTION (public API)
# =============================================================================

# Last N commits via jj log — gives change IDs, consistent with jj evolog
def fetch-commits-from [repo: string, n: int] {
    let tmpl = 'change_id.short() ++ "|" ++ commit_id.short() ++ "|" ++ author.timestamp().ago() ++ "|" ++ description.first_line() ++ "|" ++ author.name() ++ "\n"'
    try {
        jj --repository $repo log --no-graph --limit $n --template $tmpl
        | lines
        | where { |l| $l | is-not-empty }
        | each { |line|
            let p = ($line | split row "|")
            {
                change_id: ($p | get 0)
                commit_id: ($p | get 1)
                age:       ($p | get 2)
                subject:   ($p | get 3)
                author:    ($p | get 4)
            }
        }
    } catch {
        # Fallback to git log if jj template fails
        git -C $repo log --format="%h|%ad|%s|%an" --date=relative $"-($n)"
        | lines
        | where { |l| $l | is-not-empty }
        | each { |line|
            let p = ($line | split row "|")
            {
                change_id: "git"
                commit_id: ($p | get 0)
                age:       ($p | get 1)
                subject:   ($p | get 2)
                author:    ($p | get 3)
            }
        }
    }
}

# jj status for working copy
def fetch-status-from [repo: string] {
    try {
        jj --repository $repo status
        | lines
        | where { |l| $l | is-not-empty }
    } catch {
        git -C $repo status --short
        | lines
        | where { |l| $l | is-not-empty }
    }
}

# Repo metrics — ahead/behind are int|null (null = unknown, renders as "?")
def fetch-repo-stats-from [repo: string, --json] {
    let ahead = (try {
        jj --repository $repo log --no-graph -r 'remote_bookmarks()..@' --limit 100
        | lines | where { |l| $l | is-not-empty } | length
    } catch { null })

    let behind = (try {
        jj --repository $repo log --no-graph -r '@..remote_bookmarks()' --limit 100
        | lines | where { |l| $l | is-not-empty } | length
    } catch { null })

    let stats = {
        branch:      (git -C $repo branch --show-current | str trim)
        remote_url:  (try { git -C $repo remote get-url origin | str trim } catch { "none" })
        total:       (git -C $repo rev-list --count HEAD | str trim)
        last_push:   (git -C $repo log -1 --format="%ad" --date=relative | str trim)
        last_tag:    (try { git -C $repo describe --tags --abbrev=0 out+err>/dev/null | str trim } catch { "none" })
        ahead:       (if $ahead == null { "?" } else { $ahead | into string })
        behind:      (if $behind == null { "?" } else { $behind | into string })
        stash_count: (try { git -C $repo stash list | lines | length } catch { 0 })
    }

    if $json {
        $stats | to json
    } else {
        $stats
    }
}

# jj operation log — your undo stack
def fetch-op-log-from [repo: string, n: int] {
    try {
        jj --repository $repo op log --no-graph --limit $n
        | lines
        | where { |l| $l | is-not-empty }
    } catch {
        ["(op log unavailable)"]
    }
}

# Snapshot current op ID — call before pipeline starts for safe undo target
def snapshot-op-id [repo: string] {
    try {
        jj --repository $repo op log --no-graph --limit 1 --template 'id' | str trim
    } catch {
        null
    }
}

# Preview what would be pushed (dry run)
def preview-push [repo: string] {
    try {
        jj --repository $repo log --no-graph -r 'remote_bookmarks()..@'
    } catch {
        "(nothing to push or remote not reachable)"
    }
}


# =============================================================================
# SECTION 4 — RENDER
# =============================================================================

def print-git-sections [repo: string, changed: list, push_results: any, pre_op_id: string] {
    print ""
    print $"(ansi cyan_bold)── REPO STATE ──────────────────────────────────────────(ansi reset)"

    let stats = (fetch-repo-stats-from $repo)
    print $"  branch        ($stats.branch)"
    print $"  remote        ($stats.remote_url)"
    print $"  total         ($stats.total) commits"
    print $"  ahead/behind  ↑($stats.ahead) ↓($stats.behind)"
    print $"  last push     ($stats.last_push)"
    print $"  last tag      ($stats.last_tag)"
    if $stats.stash_count > 0 {
        print $"  (ansi yellow)stashes       ($stats.stash_count)(ansi reset)"
    }

    print ""
    print $"(ansi cyan_bold)── RECENT COMMITS ──────────────────────────────────────(ansi reset)"
    let commits = (fetch-commits-from $repo $config.commits_to_show)
    for c in $commits {
        print $"  ($c.change_id) ($c.commit_id)  (ansi grey)($c.age)(ansi reset)  ($c.subject)"
    }

    print ""
    print $"(ansi cyan_bold)── OPERATION LOG ───────────────────────────────────────(ansi reset)"
    let ops = (fetch-op-log-from $repo $config.op_log_to_show)
    for op in $ops {
        print $"  ($op)"
    }
    if ($pre_op_id | is-not-empty) {
        print $"  (ansi grey)undo target: ($pre_op_id)(ansi reset)"
        print $"  (ansi grey)  → jj op restore ($pre_op_id)(ansi reset)"
    }

    if ($push_results != null) {
        print ""
        print $"(ansi cyan_bold)── PUSH RESULTS ────────────────────────────────────────(ansi reset)"
        print $"  ($push_results)"
    }

    print ""
}


# =============================================================================
# SECTION 5 — MAIN PIPELINE
# =============================================================================

def ManifoldOS-Reshaping-History [msg: string = ""] {
    let repo = (pwd)
    mut timings = {}

    let steps = [
        { name: "INIT"   }
        { name: "FETCH"  }
        { name: "CHECK"  }
        { name: "COMMIT" }
        { name: "PUSH"   }
    ]

    # --- Snapshot op ID before anything touches the repo ---
    let pre_op_id = (snapshot-op-id $repo)

    # ── INIT ────────────────────────────────────────────────
    rh-flow $steps "INIT" $timings
    let t0 = (date now)
    let init_ok = (ensure-jj-initialized $repo)
    if not $init_ok { return }
    $timings = ($timings | insert "INIT" $"((date now) - $t0 | into string)")

    # ── FETCH ───────────────────────────────────────────────
    rh-flow $steps "FETCH" $timings
    let t0 = (date now)

    # Guard: warn if dirty before fetch (don't abort, just inform)
    if (has-dirty-working-copy $repo) {
        print $"(ansi yellow)  ⚠ working copy has uncommitted changes — fetch may fold remote changes in(ansi reset)"
    }

    let fetch_result = (do { jj --repository $repo git fetch } | complete)
    if $fetch_result.exit_code != 0 {
        print -e $"(ansi red_bold)  ✗ fetch failed:(ansi reset) ($fetch_result.stderr)"
        return
    }
    $timings = ($timings | insert "FETCH" $"((date now) - $t0 | into string)")

    # ── CHECK ───────────────────────────────────────────────
    rh-flow $steps "CHECK" $timings
    let t0 = (date now)

    # Conflict check
    if (has-conflicts $repo) {
        print -e $"(ansi red_bold)  ✗ conflicts detected in working copy — resolve before committing(ansi reset)"
        print -e $"    jj resolve   — interactive resolver"
        print -e $"    jj diff      — inspect conflicts"
        return
    }

    # Collect changed files for render
    let changed = (fetch-status-from $repo)
    $timings = ($timings | insert "CHECK" $"((date now) - $t0 | into string)")

    # ── COMMIT ──────────────────────────────────────────────
    rh-flow $steps "COMMIT" $timings
    let t0 = (date now)

    let commit_msg = if ($msg | is-empty) {
        let branch = (git -C $repo branch --show-current | str trim)
        let ts     = (date now | format date "%Y-%m-%d %H:%M")
        $"[$branch] ($ts)"
    } else {
        $msg
    }

    let desc_result = (do { jj --repository $repo describe -m $commit_msg } | complete)
    if $desc_result.exit_code != 0 {
        print -e $"(ansi red_bold)  ✗ describe failed:(ansi reset) ($desc_result.stderr)"
        return
    }

    let new_result = (do { jj --repository $repo new } | complete)
    if $new_result.exit_code != 0 {
        print -e $"(ansi red_bold)  ✗ jj new failed:(ansi reset) ($new_result.stderr)"
        return
    }
    $timings = ($timings | insert "COMMIT" $"((date now) - $t0 | into string)")

    # ── PUSH ────────────────────────────────────────────────
    rh-flow $steps "PUSH" $timings
    let t0 = (date now)

    # Dry-run preview
    let preview = (preview-push $repo)
    print ""
    print $"(ansi cyan_bold)  Push preview:(ansi reset)"
    print $"($preview)"
    print ""
    print -n "  Proceed? [y/N] "
    let answer = (input)
    if ($answer | str downcase) != "y" {
        print $"(ansi yellow)  Push cancelled.(ansi reset)"
        $timings = ($timings | insert "PUSH" "cancelled")
        print-git-sections $repo $changed null $pre_op_id
        return
    }

    let push_result = (do { jj --repository $repo git push } | complete)
    let push_output = if $push_result.exit_code != 0 {
        print -e $"(ansi red_bold)  ✗ push failed:(ansi reset) ($push_result.stderr)"
        $push_result.stderr
    } else {
        $push_result.stdout
    }
    $timings = ($timings | insert "PUSH" $"((date now) - $t0 | into string)")

    rh-flow $steps "DONE" $timings
    print-git-sections $repo $changed $push_output $pre_op_id
}


# =============================================================================
# SECTION 6 — CONVENIENCE COMMANDS
# =============================================================================

# Undo last jj operation (Ctrl+Z)
def jj-undo [] {
    let repo = (pwd)
    let result = (do { jj --repository $repo op undo } | complete)
    if $result.exit_code != 0 {
        print -e $"(ansi red_bold)  ✗ undo failed:(ansi reset) ($result.stderr)"
    } else {
        print $"(ansi green)  ✓ undone(ansi reset)"
        fetch-op-log-from $repo 3 | each { |l| print $"  ($l)" }
    }
}

# Restore to a specific op ID (use the undo target printed after each push)
def jj-restore-op [op_id: string] {
    let repo = (pwd)
    let result = (do { jj --repository $repo op restore $op_id } | complete)
    if $result.exit_code != 0 {
        print -e $"(ansi red_bold)  ✗ restore failed:(ansi reset) ($result.stderr)"
    } else {
        print $"(ansi green)  ✓ restored to op ($op_id)(ansi reset)"
    }
}

# Split the current commit interactively
def jj-split [] {
    jj --repository (pwd) split
}

# Squash working copy into parent
def jj-squash [] {
    jj --repository (pwd) squash
}

# Quick glance at evolution log for current change
def jj-evolog [] {
    jj --repository (pwd) evolog
}

# Show full repo stats as JSON (for piping to dashboards / status bars)
def jj-stats-json [] {
    fetch-repo-stats-from (pwd) --json
}


# =============================================================================
# SECTION 7 — KEYBINDINGS
# =============================================================================

$env.config.keybindings = ($env.config.keybindings | append [
    {
        name: reshape_history
        modifier: control
        keycode: char_g
        mode: [emacs vi_normal vi_insert]
        event: { send: executehostcommand cmd: "ManifoldOS-Reshaping-History" }
    }
    {
        name: jj_undo
        modifier: control
        keycode: char_z
        mode: [emacs vi_normal vi_insert]
        event: { send: executehostcommand cmd: "jj-undo" }
    }
])