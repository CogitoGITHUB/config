#+TITLE:      Templates System
#+begin_comment
Template infrastructure: directory root, org-capture (doct), yasnippet.
#+end_comment
* Templates Directory
:PROPERTIES:
:CATEGORY: config
:END:
#+begin_src emacs-lisp
(defun my/templates-directory ()
  "Return the root templates directory.
Delegates to the central module path helper."
  (my/manifolding-atlas-templates-dir))
#+end_src
** Org Capture (doct)
:PROPERTIES:
:PACKAGE:  doct
:STRAIGHT: (doct :type git :host github :repo "progfolio/doct")
:CATEGORY: editing
:END:
#+begin_src emacs-lisp
(defun my/capture-directory ()
  "Return the org-capture (doct) templates directory."
  (expand-file-name "files/" (my/templates-directory)))
(with-eval-after-load 'org-capture
  (require 'doct)
  (dolist (f (directory-files (my/capture-directory) t "\\.el$"))
    (load f nil 'no-message))
  (setq org-capture-templates
        (append (when (boundp 'my/capture-manifolding-atlas) my/capture-manifolding-atlas)
                (when (boundp 'my/capture-tasks)  my/capture-tasks))))
#+end_src
** Yasnippet
:PROPERTIES:
:PACKAGE:  yasnippet
:STRAIGHT: (yasnippet :type git :host github :repo "joaotavora/yasnippet")
:CATEGORY: editing
:END:
#+begin_src emacs-lisp
(let ((snippets-dir (expand-file-name "snippets/" (my/templates-directory))))
  (make-directory snippets-dir t)
  (setq yas-snippet-dirs (list snippets-dir)))
(yas-global-mode 1)
#+end_src
