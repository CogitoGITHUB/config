;; After any vulpea-create call, open the new file in an org-capture buffer
;; for body editing (C-c C-c to save, C-c C-k to abort).
;; org-capture-use-indirect-buffer is nil to avoid indirect buffer mode issues.
;;
;; my/vulpea--skip-capture is dynamically bound to t inside the capture
;; helpers so that their own org-capture session does not spawn a second one.
(defvar my/vulpea--skip-capture nil
  "Non-nil suppresses the post-create org-capture opened by advice.")
(defvar my/vulpea--new-note nil
  "The note object when a new note was just created by vulpea-create.
Used by `my/vulpea-find-advice' to detect new notes.")

(defun my/vulpea--open-capture-for-note (note)
  "Open NOTE for body editing via org-capture.
`org-capture-use-indirect-buffer' is bound to nil because the
indirect buffer does not reliably inherit org-capture-mode in
this modaled setup, causing C-c C-c to fall through to the
catch-all error in `org-ctrl-c-ctrl-c'."
  (let* ((file (vulpea-note-path note))
         (template `("v" "Edit note body"
                     plain
                     (file+function ,file
                       (lambda ()
                         (goto-char (point-max))
                         (skip-chars-backward " \t\n")
                         (insert "\n")))
                     ""
                     :kill-buffer t))
         (org-capture-use-indirect-buffer nil)
         (org-capture-templates (list template)))
    ;; Switch off the file so org-capture saves window config with
    ;; a live buffer — after `:kill-buffer t' the restore shows a
    ;; live buffer instead of a dead-buffer hole filled by *scratch*.
    (when-let ((buf (get-file-buffer file)))
      (when (eq buf (current-buffer))
        (switch-to-buffer (other-buffer))))
    (org-capture nil "v")))

(defun my/vulpea--cleanup-after-capture ()
  "After org-capture finalizes, kill the vulpea file buffer.
Runs via `org-capture-after-finalize-hook'.  Uses idle-timer so
the kill happens after any background processes (vulpea sync,
fswatch) that might re-open the file have finished."
  (when (and (bound-and-true-p my/vulpea--new-note)
             my/vulpea--new-note)
    (let ((file (vulpea-note-path my/vulpea--new-note)))
      (when file
        (run-at-time 0 nil
                     (lambda (f)
                       (when-let ((buf (get-file-buffer f)))
                         (kill-buffer buf)))
                     file)))
    (setq my/vulpea--new-note nil)))

(add-hook 'org-capture-after-finalize-hook #'my/vulpea--cleanup-after-capture)

(defun my/vulpea-links--current-note-id ()
  "Return the ID of the vulpea note at point, or nil.
Checks heading-level ID first, then file-level ID."
  (or (org-id-get)
      (org-entry-get (point-min) "ID")))

(defun my/vulpea--property-put (note key value)
  "Set org property KEY to VALUE on NOTE using `org-entry-put'.
This stores the property inside NOTE's property drawer, making it
queryable via `vulpea-note-properties' and the vulpea SQL properties table."
  (let* ((file (vulpea-note-path note))
         (pos (vulpea-note-pos note))
         (level (vulpea-note-level note)))
    (with-current-buffer (find-file-noselect file)
      (save-excursion
        (cond
         ((and level (> level 0) pos)
          (goto-char pos)
          (org-back-to-heading t))
         (t
          (goto-char (point-min))))
        (org-entry-put (point) key value)
        (save-buffer)))))

(defun my/vulpea--open-in-capture (note)
  "After vulpea-create: record source relationship, commit, set up capture."
  (when note
    ;; Record source relationship from the current note context
    (when-let* ((source-id (my/vulpea-links--current-note-id))
                ((not (string= source-id (vulpea-note-id note)))))
      (my/vulpea--property-put note "SOURCE" source-id))
    (let* ((file     (expand-file-name (vulpea-note-path note)))
           (root     (let ((default-directory (file-name-directory file)))
                       (expand-file-name (or (magit-toplevel) ""))))
           (relative (file-relative-name file root))
           (msg      (format "vulpea: %s [%s]" relative (format-time-string "%H:%M:%S"))))
      (let ((default-directory root))
        (when (and (= 0 (magit-call-git "add" file))
                   (= 0 (magit-call-git "commit" "-m" msg)))
          (message "✓ vulpea committed: %s" relative)))
      (setq my/vulpea--new-note note)))
  note)

(defun my/vulpea-find-advice (original-fn &rest args)
  "Wrap `vulpea-find' to open org-capture for newly created notes.
Uses `let*' so that `my/vulpea--new-note' is bound before
`(apply original-fn args)' runs — the `:filter-return' advice on
`vulpea-create' fires during that call and `setq's the
let-bound variable.  With `let' the initforms are all evaluated
before any binding, so the `setq' would hit the global instead."
  (let* ((my/vulpea--skip-capture t)
         (my/vulpea--new-note nil)
         (result (apply original-fn args)))
    (when my/vulpea--new-note
      (my/vulpea--open-capture-for-note my/vulpea--new-note))
    result))

(with-eval-after-load 'vulpea
  (advice-add 'vulpea-create :filter-return #'my/vulpea--open-in-capture)
  (advice-add 'vulpea-find :around #'my/vulpea-find-advice)
  (advice-add 'vulpea-insert :around #'my/vulpea-find-advice))
