                                            nil nil)))
                    (unless (string-empty-p s) s)))
                 (priority
                  (let ((p (read-string "Priority ([A]/[B]/[C] or blank): ")))
                    (unless (string-empty-p p) (upcase (substring p 0 1)))))
                 (scheduled
                  (let ((raw (read-string "SCHEDULED (e.g. <2025-06-01 Sun> or blank): ")))
                    (unless (string-empty-p raw) raw)))
