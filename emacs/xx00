                 (tags
                  (completing-read-multiple
                   "Tags (comma to separate): "
                   (vulpea-db-query-tags)))
                 (extra-props
                  (let (props)
                    (catch 'done
                      (while t
                        (let ((k (read-string "Property key (blank to stop): ")))
                          (if (string-empty-p k)
                              (throw 'done props)
                            (push (cons k (read-string (format "Value for %s: " k)))
                                  props)))))
                    (nreverse props)))
                 (todo
                  (let ((s (completing-read "TODO state (blank for none): "
                                            '("TODO" "NEXT" "WAITING"
