(defun my/vulpea-capture-new-file ()
  "Prompt for title, subdir and tags; create the note; return its path."
  (let* ((my/vulpea--skip-capture t)
         (vulpea-create-default-function (lambda (_) '()))
         (title  (read-string "Note title: "))
         (subdir (my/vulpea-prompt-subdir))
          (tags   (let ((raw (read-string "Tags (comma-separated, or blank): ")))
                   (unless (string-empty-p raw)
                     (mapcar #'string-trim (split-string raw "," t))))))
    (vulpea-note-path
     (vulpea-create
      title
      (concat subdir (vulpea-title-to-slug title) ".org")
      :tags tags))))
(defun my/vulpea-capture-task-file ()
  "Prompt for task metadata; create the note tagged task; return its path."
  (let* ((my/vulpea--skip-capture t)
         (vulpea-create-default-function (lambda (_) '()))
         (title  (read-string "Task title: "))
         (subdir (my/vulpea-prompt-subdir))
          (tags   (let ((raw (read-string "Extra tags (comma-separated, or blank): ")))
                   (cons "task"
                         (unless (string-empty-p raw)
                           (mapcar #'string-trim (split-string raw "," t))))))
         (todo   (completing-read "TODO state: "
                                  '("TODO" "NEXT" "WAITING") nil t "TODO"))
         (prio   (let ((p (read-string "Priority [A/B/C] (blank = B): ")))
                   (if (string-empty-p p) "B" (upcase p)))))
    (vulpea-note-path
     (vulpea-create
      title
      (concat subdir (vulpea-title-to-slug title) ".org")
      :tags tags
      :properties `(("TODO"     . ,todo)
                    ("PRIORITY" . ,prio))))))
