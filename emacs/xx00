                    (unless (string-empty-p raw) raw))))
             (list
              :file-name  file-name
              :tags       tags
              :properties (append
                           extra-props
                           (when aliases (list (cons "ALIAS" (string-join aliases ", "))))
                           (when todo     (list (cons "TODO"     todo)))
                           (when priority (list (cons "PRIORITY" priority))))
