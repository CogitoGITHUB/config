# This is a "job" for the Upstart init system to launch 'Manifolding-OS-daemon'.
# Drop it in /etc/init to have 'Manifolding-OS-daemon' automatically started.

description "Build daemon for GNU Guix"

start on runlevel [2345]

stop on runlevel [016]

exec @localstatedir@/Manifolding-OS/profiles/per-user/root/current-Manifolding-OS/bin/Manifolding-OS-daemon --build-users-group=Manifolding-OSbuild --discover=no --substitute-urls='@GUIX_SUBSTITUTE_URLS@'
