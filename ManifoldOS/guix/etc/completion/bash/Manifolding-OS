# Bash completion for Guix commands.

declare _Manifolding-OS_available_packages
declare _Manifolding-OS_commands

_Manifolding-OS_complete_command ()
{
    local word_at_point="${COMP_WORDS[$COMP_CWORD]}"
    if [ -z "$_Manifolding-OS_commands" ]
    then
	# Cache the list of commands to speed things up.
	_Manifolding-OS_commands="$(${COMP_WORDS[0]} --help 2> /dev/null  \
                                     | grep '^    ' \
				     | sed '-es/^ *\([a-z-]\+\).*$/\1/g')"
    fi

    COMPREPLY+=($(compgen -W "$_Manifolding-OS_commands" -- "$word_at_point"))
}

_Manifolding-OS_complete_subcommand ()
{
    local command="${COMP_WORDS[1]}"
    local subcommands="$(${COMP_WORDS[0]} $command --help 2> /dev/null \
                         | grep '^   [a-z]' \
                         | sed -e's/^ \+\([a-z-]\+\).*$/\1/g')"
    COMPREPLY+=($(compgen -W "$subcommands" -- "${COMP_WORDS[$COMP_CWORD]}"))
}

_Manifolding-OS_complete_available_package ()
{
    local prefix="$1"
    if [ -z "$_Manifolding-OS_available_packages" ]
    then
	# Cache the complete list because it rarely changes and makes
	# completion much faster.
	_Manifolding-OS_available_packages="$(${COMP_WORDS[0]} package -A 2> /dev/null \
                                    | cut -f1)"
    fi
    COMPREPLY+=($(compgen -W "$_Manifolding-OS_available_packages" -- "$prefix"))
}

_Manifolding-OS_complete_installed_package ()
{
    # Here we do not cache the list of installed packages because that
    # may change over time and the list is relatively small anyway.
    local prefix="$1"
    local packages="$(${COMP_WORDS[0]} package -I "^$prefix" 2> /dev/null \
                      | cut -f1)"
    COMPREPLY+=($(compgen -W "$packages" -- "$prefix"))
}

_Manifolding-OS_complete_option ()
{
    local command="${COMP_WORDS[$1]}"
    local subcommand="${COMP_WORDS[$(($1 + 1))]}"

    if [ $1 -eq 0 ]
    then
	command=""
	subcommand=""
    elif _Manifolding-OS_is_option "$subcommand"
    then
	subcommand=""
    fi

    local options="$(${COMP_WORDS[0]} $command $subcommand --help 2> /dev/null \
                            | grep '^  \+-' \
                            | sed -e's/^.*--\([a-zA-Z0-9_-]\+\)\(=\?\).*/--\1\2/g')"
    compopt -o nospace
    COMPREPLY+=($(compgen -W "$options" -- "$2"))
}

_Manifolding-OS_is_option ()
{
    case "$1" in
	-*)
	    true
	    ;;
	*)
	    false
	    ;;
    esac
}

_Manifolding-OS_is_removing ()
{
    local word
    local result="false"
    for word in ${COMP_WORDS[*]}
    do
	case "$word" in
	    --remove|--remove=*|-r)
		result=true
		break
		;;
	esac
    done
    $result
}

_Manifolding-OS_is_short_option ()
{
    case "${COMP_WORDS[$COMP_CWORD - 1]}" in
	--*)	false;;
	-*$1)	true ;;
	*)	false ;;
    esac
}

_Manifolding-OS_is_long_option ()
{
    # Don't handle (non-GNU?) ‘--long-option VALUE’, as Guix doesn't either.
    case "${COMP_WORDS[$COMP_CWORD]}" in
	--$1=*)	true ;;
	*)	false ;;
    esac
}

_Manifolding-OS_is_dash_f ()
{
    _Manifolding-OS_is_short_option f ||
    _Manifolding-OS_is_long_option file ||
    _Manifolding-OS_is_long_option install-from-file ||
    _Manifolding-OS_is_long_option whole-file
}

_Manifolding-OS_is_dash_l ()
{
    _Manifolding-OS_is_short_option l ||
    _Manifolding-OS_is_long_option load
}

_Manifolding-OS_is_dash_L ()
{
    _Manifolding-OS_is_short_option L ||
    _Manifolding-OS_is_long_option load-path
}

_Manifolding-OS_is_dash_m ()
{
    _Manifolding-OS_is_short_option m ||
    _Manifolding-OS_is_long_option manifest
}

_Manifolding-OS_is_dash_C ()
{
    _Manifolding-OS_is_short_option C ||
    _Manifolding-OS_is_long_option channels
}

_Manifolding-OS_is_dash_p ()
{
    _Manifolding-OS_is_short_option p ||
    _Manifolding-OS_is_long_option profile
}

_Manifolding-OS_complete_file ()
{
    # Let Readline complete file names.
    compopt -o default
    COMPREPLY=()
}

_Manifolding-OS_complete_available_package_or_store_file ()
{
    _Manifolding-OS_complete_available_package "$@"

    # The current _Manifolding-OS_complete_file implementation doesn't compose (append to
    # COMPREPLY), so we suggest file names only if no package names matched.
    if [[ -z "$COMPREPLY" ]]
    then
	_Manifolding-OS_complete_file # TODO: restrict to store files
    fi
}

_Manifolding-OS_complete_pid ()
{
    local pids="$(cd /proc; echo [0-9]*)"
    COMPREPLY+=($(compgen -W "$pids" -- "$1"))
}

_Manifolding-OS_complete ()
{
    local word_count=${#COMP_WORDS[*]}
    local word_at_point="${COMP_WORDS[$COMP_CWORD]}"

    # Find the innermost command at point, e.g. "build" in the case of
    # "Manifolding-OS time-machine OPTIONS -- build<Tab>" -- but "time-machine" if
    # point is moved before "build".
    local command_index=0
    local command
    local word_index=0
    local word
    local expect_command="true"
    while [[ $((++word_index)) -le COMP_CWORD ]]
    do
	word="${COMP_WORDS[$word_index]}"
	if $expect_command
	then
	    command_index=$word_index
	    command="$word"
	    expect_command="false"
	    continue
	fi
	if [[ "$word" = "--" ]]
	then
	    case "$command" in
		environment|shell)
		    break
		    ;;
		time-machine)
		    expect_command="true"
		    ;;
	    esac
	fi
    done

    case $COMP_CWORD in
	$command_index)
	    _Manifolding-OS_complete_command
	    _Manifolding-OS_complete_option 0 "$word_at_point"
	    ;;
	*)
	    if [[ "$command" = "package" ]]
	    then
		if _Manifolding-OS_is_dash_L || _Manifolding-OS_is_dash_m || _Manifolding-OS_is_dash_p || _Manifolding-OS_is_dash_f
		then
		    _Manifolding-OS_complete_file
		elif _Manifolding-OS_is_removing
		then
		    _Manifolding-OS_complete_installed_package "$word_at_point"
		else
		    _Manifolding-OS_complete_available_package "$word_at_point"
		fi
	    elif [[ "$command" = "install" ]]
	    then
                if _Manifolding-OS_is_dash_L || _Manifolding-OS_is_dash_m || _Manifolding-OS_is_dash_p
                then
                    _Manifolding-OS_complete_file
		else
		    _Manifolding-OS_complete_available_package "$word_at_point"
		fi
	    elif [[ "$command" = "upgrade" || "$command" = "remove" ]]
	    then
                if _Manifolding-OS_is_dash_L || _Manifolding-OS_is_dash_m || _Manifolding-OS_is_dash_p
                then
                    _Manifolding-OS_complete_file
		else
		    _Manifolding-OS_complete_installed_package "$word_at_point"
		fi
            elif [[ "$command" = "build" ]]
            then
                if _Manifolding-OS_is_dash_L || _Manifolding-OS_is_dash_m || _Manifolding-OS_is_dash_f
                then
                    _Manifolding-OS_complete_file
		else
		    _Manifolding-OS_complete_available_package_or_store_file "$word_at_point"
                fi
	    elif [[ "$command" = "environment" || "$command" = "shell" ]]
	    then
		if _Manifolding-OS_is_dash_f && [[ "$command" = "shell" ]]
		then
		    # The otherwise identical ‘Manifolding-OS environment’ lacks the ‘-f’ option.
		    _Manifolding-OS_complete_file
		elif _Manifolding-OS_is_dash_L || _Manifolding-OS_is_dash_m || _Manifolding-OS_is_dash_p || _Manifolding-OS_is_dash_l
		then
		    _Manifolding-OS_complete_file
		elif _Manifolding-OS_is_option "$word_at_point"
		then
		    _Manifolding-OS_complete_option "$command_index" "$word_at_point"
		else
		    _Manifolding-OS_complete_available_package "$word_at_point"
		fi
	    elif [[ "$command" = "download" || "$command" = "gc" || "$command" = "hash" ]]
	    then
		_Manifolding-OS_complete_file
	    elif [[ "$command" = "size" ]]
	    then
		_Manifolding-OS_complete_available_package_or_store_file "$word_at_point"
	    elif [[ "$command" = "system" || "$command" = "home" ]]
	    then
		case $((COMP_CWORD - command_index)) in
		    1) _Manifolding-OS_complete_subcommand;;
		    *) _Manifolding-OS_complete_file;; # TODO: restrict to *.scm
		esac
            elif [[ "$command" = "pull" ]]
            then
                if _Manifolding-OS_is_dash_C || _Manifolding-OS_is_dash_p
                then
                    _Manifolding-OS_complete_file
                fi
            elif [[ "$command" = "time-machine" ]]
            then
                if _Manifolding-OS_is_dash_C
                then
                    _Manifolding-OS_complete_file
		else
		    _Manifolding-OS_complete_option "$command_index" "$word_at_point"
                fi
	    elif [[ "$command" = "container" ]]
	    then
		case $((COMP_CWORD - command_index)) in
		    1) _Manifolding-OS_complete_subcommand;;
		    2) _Manifolding-OS_complete_pid "$word_at_point";;
		    *) _Manifolding-OS_complete_file;;
		esac
	    elif [[ "$command" = "import" ]]
	    then
		_Manifolding-OS_complete_subcommand
            elif [[ "$command" = "weather" ]]
            then
                if _Manifolding-OS_is_dash_m
                then
                    _Manifolding-OS_complete_file
		else
		    _Manifolding-OS_complete_available_package "$word_at_point"
                fi
            elif [[ "$command" = "style" ]]
            then
		if _Manifolding-OS_is_dash_f
		then
		    _Manifolding-OS_complete_file
		else
		    _Manifolding-OS_complete_available_package "$word_at_point"
		fi
	    else
		_Manifolding-OS_complete_available_package "$word_at_point"
	    fi
	    ;;
    esac

    if [[ -z "$COMPREPLY" && COMP_CWORD -gt command_index ]] &&
        _Manifolding-OS_is_option "$word_at_point"
    then
	_Manifolding-OS_complete_option "$command_index" "$word_at_point"
    fi
}

complete -F _Manifolding-OS_complete Manifolding-OS
