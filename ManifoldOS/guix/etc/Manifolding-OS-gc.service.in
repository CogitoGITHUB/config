# This is a "service unit file" for the systemd init system to perform a
# one-shot 'Manifolding-OS gc' operation.  It is meant to be triggered by a timer.
# Drop it in /etc/systemd/system or similar together with 'Manifolding-OS-gc.timer'
# to set it up.

[Unit]
Description=Discard unused Guix store items

[Service]
Type=oneshot
# Customize the 'Manifolding-OS gc' arguments to fit your needs.
ExecStart=@localstatedir@/Manifolding-OS/profiles/per-user/root/current-Manifolding-OS/bin/Manifolding-OS gc -d 1m -F 10G
PrivateDevices=yes
PrivateNetwork=yes
PrivateUsers=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@default @file-system @basic-io @system-service
